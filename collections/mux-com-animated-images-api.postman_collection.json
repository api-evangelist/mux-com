  "item": [
    {
      "id": "6f591021-75c0-4a6a-b3db-3405d87765a0",
      "name": "Animated Images",
      "description": {
        "content": "APIs for retrieving animated images from videos hosted using Mux.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1645d073-88b7-48d1-8ac2-dd7c8c0ef2b5",
          "name": "Retrieve an Animated Image from a Video",
          "request": {
            "name": "Retrieve an Animated Image from a Video",
            "description": {
              "content": "[Fetch an animated GIF or WebP image](https://docs.mux.com/guides/get-images-from-a-video#get-an-animated-gif-from-a-video) from a video segment with optional transformations.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                ":PLAYBACK_ID",
                "animated.{{EXTENSION}}"
              ],
              "host": [
                "image",
                "mux",
                "com"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "TOKEN",
                  "value": "<string>",
                  "description": "Signed token (JWT) for [secure video playback](https://docs.mux.com/guides/secure-video-playback)."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<float>",
                  "description": "The time (in seconds) of the video timeline where the animated GIF should begin. Defaults to 0."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<float>",
                  "description": "The time (in seconds) of the video timeline where the GIF ends. Defaults to 5 seconds after the start. Maximum total duration of GIF is limited to 10 seconds; minimum total duration of GIF is 250ms."
                },
                {
                  "disabled": false,
                  "key": "width",
                  "value": "<integer>",
                  "description": "The width in pixels of the animated GIF. Default is 320px, or if height is provided, the width is determined by preserving aspect ratio with the height. Max width is 640px."
                },
                {
                  "disabled": false,
                  "key": "height",
                  "value": "<integer>",
                  "description": "The height in pixels of the animated GIF. The default height is determined by preserving aspect ratio with the width provided. Maximum height is 640px."
                },
                {
                  "disabled": false,
                  "key": "fps",
                  "value": "<integer>",
                  "description": "The frame rate of the generated GIF. Defaults to 15 fps. Max 30 fps."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "PLAYBACK_ID",
                  "description": "(Required) The asset or live stream's playback ID."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "image/gif"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "378e9303-37bd-4103-835a-820e62b50db2",
