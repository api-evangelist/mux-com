        {
          "id": "c1a14de4-c0f5-4ec3-bfa7-574e84d63eb9",
          "name": "Retrieve a Transcript",
          "request": {
            "name": "Retrieve a Transcript",
            "description": {
              "content": "Fetch a [transcript of an asset](https://docs.mux.com/guides/add-autogenerated-captions-and-use-transcripts#retrieve-a-transcript). This is only possible for assets with a text track generated using the [VOD generated captions feature](https://docs.mux.com/guides/add-autogenerated-captions-and-use-transcripts).",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                ":PLAYBACK_ID",
                "text",
                "{{TRACK_ID}}.txt"
              ],
              "host": [
                "stream",
                "mux",
                "com"
              ],
