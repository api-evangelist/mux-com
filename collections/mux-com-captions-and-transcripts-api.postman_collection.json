      "id": "83cbb0f9-53e4-422b-84fd-542e40095049",
      "name": "Captions and Transcripts",
      "description": {
        "content": "APIs for retrieving captions and transcripts from videos hosted using Mux that have had captions generated automatically.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6ffe4377-27c7-44e4-a1a0-30bf07326c91",
          "name": "Retrieve a WebVTT File for a Text Track",
          "request": {
            "name": "Retrieve a WebVTT File for a Text Track",
            "description": {
              "content": "Fetch a standalone WebVTT version of a text track from an asset.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                ":PLAYBACK_ID",
                "text",
                "{{TRACK_ID}}.vtt"
              ],
              "host": [
                "stream",
                "mux",
                "com"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "TOKEN",
                  "value": "<string>",
                  "description": "Signed token (JWT) for [secure video playback](https://docs.mux.com/guides/secure-video-playback)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "PLAYBACK_ID",
                  "description": "(Required) The asset or live stream's playback ID."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/vtt"
              }
            ],
            "method": "GET",
            "auth": null
          },
