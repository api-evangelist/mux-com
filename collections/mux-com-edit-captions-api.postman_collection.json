                  "raw": "{\n  \"parameters\": {\n    \"asset_id\": \"mux_asset_123abc\",\n    \"track_id\": \"text_track_456def\",\n    \"replacements\": [\n      {\n        \"find\": \"Mucks\",\n        \"replace\": \"Mux\",\n        \"case_sensitive\": true\n      },\n      {\n        \"find\": \"gonna\",\n        \"replace\": \"going to\"\n      }\n    ],\n    \"upload_to_mux\": true,\n    \"delete_original_track\": true\n  }\n}",
