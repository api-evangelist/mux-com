  "item": [
    {
      "id": "0382fd04-6f1c-4cd9-b9ef-76c1b73af14e",
      "name": "Edit Captions",
      "description": {
        "content": "Edit an existing caption track with find-and-replace edits and optional profanity censoring. This workflow is currently in beta.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "e0eb0d06-3383-4b12-8701-d4b939e52d12",
          "name": "Create an 'edit-Captions' Job",
          "request": {
            "name": "Create an 'edit-Captions' Job",
            "description": {
              "content": "Creates a new job that edits an existing Mux text track using static replacements and optional profanity censoring. Provide at least one of `replacements` or `auto_censor_profanity`.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "robots",
                "v0",
                "jobs",
                "edit-captions"
              ],
              "host": [
                "api",
                "mux",
                "com"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parameters\": {\n    \"asset_id\": \"<string>\",\n    \"track_id\": \"<string>\",\n    \"auto_censor_profanity\": {\n      \"detection_method\": \"llm\",\n      \"mode\": \"blank\",\n      \"always_censor\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"never_censor\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    },\n    \"replacements\": [\n      {\n        \"find\": \"<string>\",\n        \"replace\": \"<string>\",\n        \"case_sensitive\": false\n      },\n      {\n        \"find\": \"<string>\",\n        \"replace\": \"<string>\",\n        \"case_sensitive\": false\n      }\n    ],\n    \"upload_to_mux\": true,\n    \"delete_original_track\": true,\n    \"track_name_suffix\": \"<string>\"\n  },\n  \"passthrough\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
