          "name": "List Jobs",
          "request": {
            "name": "List Jobs",
            "description": {
              "content": "Returns a paginated list of Robots jobs, with optional filters for workflow, status, and asset_id. Jobs are automatically deleted after 30 days.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "robots",
                "v0",
                "jobs"
              ],
              "host": [
                "api",
                "mux",
                "com"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "workflow",
                  "value": "<string>",
                  "description": "Filter by workflow name"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter by job status"
                },
                {
                  "disabled": false,
                  "key": "asset_id",
                  "value": "<string>",
                  "description": "Filter by Mux asset ID"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "Maximum number of jobs to return (default 25, max 100)"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default 1)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
