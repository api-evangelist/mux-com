              "mode": "raw",
              "raw": "{\n  \"parameters\": {\n    \"asset_id\": \"<string>\",\n    \"language_code\": \"en\",\n    \"thresholds\": {\n      \"sexual\": 0.7,\n      \"violence\": 0.8\n    },\n    \"sampling_interval\": \"<integer>\",\n    \"max_samples\": \"<integer>\"\n  },\n  \"passthrough\": \"<string>\"\n}",
