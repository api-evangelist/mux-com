          "id": "1c8063e4-36f4-4518-83a8-b865d98fb669",
          "name": "Retrieve Information About Your Current Access Token.",
          "request": {
            "name": "Retrieve Information About Your Current Access Token.",
            "description": {
              "content": "Retrieve information about your current access token, including organization, environment, and permissions. Note that this can only be access with an access token, and _all_ access tokens can access this route, regardless of what permissions they have assigned.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "system",
                "v1",
                "whoami"
              ],
              "host": [
                "api",
                "mux",
                "com"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "4faad200-3578-4f57-b02c-6690d4219c0c",
